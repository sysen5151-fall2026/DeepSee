# Copy to backend/core/.env (next to manage.py) or export in the shell.

# Django
DJANGO_SECRET_KEY=change-me-before-any-shared-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to call the API (the clinician workspace dev server by default)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional PostgreSQL connection string. SQLite is used when unset.
# DATABASE_URL=postgresql://user:password@localhost:5432/deepsee
