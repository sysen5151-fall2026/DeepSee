# Copy to .env.local to change defaults.

# Leave unset (or set to "demo") to run the clinician workspace with the built-in mock model.
# Point it at the local inference service to run in connected mode.
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional version label shown on the support page.
# NEXT_PUBLIC_APP_VERSION=0.2.0-prototype
